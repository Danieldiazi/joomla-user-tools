  <license>GPL-2.0-or-later</license>
  <authorUrl>https://github.com/Danieldiazi/joomla-user-tools</authorUrl>
  <version>2026.10.21</version>
  <description>COM_USERTOOLS_XML_DESCRIPTION</description>
