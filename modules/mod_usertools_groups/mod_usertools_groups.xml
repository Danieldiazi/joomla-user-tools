<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
  <name>MOD_USERTOOLS_GROUPS</name>
  <author>Danieldiazi</author>
  <creationDate>2026-10</creationDate>
  <copyright>(C) 2026 Danieldiazi</copyright>
  <license>GPL-2.0-or-later</license>
  <authorUrl>https://github.com/Danieldiazi/joomla-user-tools</authorUrl>
  <version>2026.10.10</version>
  <description>MOD_USERTOOLS_GROUPS_XML_DESCRIPTION</description>
  <namespace path="src">Danieldiazi\Module\UsertoolsGroups</namespace>
  <files>
    <folder module="mod_usertools_groups">services</folder>
    <folder>src</folder>
    <folder>tmpl</folder>
    <folder>language</folder>
  </files>
  <languages>
    <language tag="es-ES">language/es-ES/mod_usertools_groups.ini</language>
    <language tag="es-ES">language/es-ES/mod_usertools_groups.sys.ini</language>
    <language tag="en-GB">language/en-GB/mod_usertools_groups.ini</language>
    <language tag="en-GB">language/en-GB/mod_usertools_groups.sys.ini</language>
  </languages>
  <config>
    <fields name="params">
      <fieldset name="basic">
        <field name="privacy_note" type="note" class="alert alert-info" description="MOD_USERTOOLS_GROUPS_PRIVACY_NOTE" />
        <field name="mode" type="list" label="MOD_USERTOOLS_GROUPS_FIELD_MODE_LABEL" default="user" validate="options" class="form-select">
          <option value="user">MOD_USERTOOLS_GROUPS_FIELD_MODE_USER</option>
          <option value="members">MOD_USERTOOLS_GROUPS_FIELD_MODE_MEMBERS</option>
        </field>

        <field name="user_source" type="list" label="MOD_USERTOOLS_GROUPS_FIELD_USER_SOURCE_LABEL" description="MOD_USERTOOLS_GROUPS_FIELD_USER_SOURCE_DESC" default="current" validate="options" class="form-select" showon="mode:user">
          <option value="current">MOD_USERTOOLS_GROUPS_FIELD_USER_SOURCE_CURRENT</option>
          <option value="specific">MOD_USERTOOLS_GROUPS_FIELD_USER_SOURCE_SPECIFIC</option>
        </field>
        <field name="user_id" type="user" label="MOD_USERTOOLS_GROUPS_FIELD_USER_LABEL" filter="integer" showon="mode:user[AND]user_source:specific" />
        <field name="inherited" type="radio" label="MOD_USERTOOLS_GROUPS_FIELD_INHERITED_LABEL" description="MOD_USERTOOLS_GROUPS_FIELD_INHERITED_DESC" layout="joomla.form.field.radio.switcher" default="0" filter="integer" showon="mode:user">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
        <field name="hidden_groups" type="usergrouplist" label="MOD_USERTOOLS_GROUPS_FIELD_HIDDEN_LABEL" description="MOD_USERTOOLS_GROUPS_FIELD_HIDDEN_DESC" multiple="true" layout="joomla.form.field.list-fancy-select" showon="mode:user" />

        <field name="group_id" type="usergrouplist" label="MOD_USERTOOLS_GROUPS_FIELD_GROUP_LABEL" filter="integer" showon="mode:members">
          <option value="">MOD_USERTOOLS_GROUPS_FIELD_GROUP_SELECT</option>
        </field>
        <field name="subgroups" type="radio" label="MOD_USERTOOLS_GROUPS_FIELD_SUBGROUPS_LABEL" description="MOD_USERTOOLS_GROUPS_FIELD_SUBGROUPS_DESC" layout="joomla.form.field.radio.switcher" default="0" filter="integer" showon="mode:members">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
        <field name="display" type="list" label="MOD_USERTOOLS_GROUPS_FIELD_DISPLAY_LABEL" default="name" validate="options" class="form-select" showon="mode:members">
          <option value="name">MOD_USERTOOLS_GROUPS_FIELD_DISPLAY_NAME</option>
          <option value="username">MOD_USERTOOLS_GROUPS_FIELD_DISPLAY_USERNAME</option>
          <option value="both">MOD_USERTOOLS_GROUPS_FIELD_DISPLAY_BOTH</option>
        </field>
        <field name="hide_backend" type="radio" label="MOD_USERTOOLS_GROUPS_FIELD_HIDE_BACKEND_LABEL" description="MOD_USERTOOLS_GROUPS_FIELD_HIDE_BACKEND_DESC" layout="joomla.form.field.radio.switcher" default="1" filter="integer" showon="mode:members">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
        <field name="limit" type="number" label="MOD_USERTOOLS_GROUPS_FIELD_LIMIT_LABEL" description="MOD_USERTOOLS_GROUPS_FIELD_LIMIT_DESC" default="50" min="1" max="1000" filter="integer" validate="number" showon="mode:members" />
        <field name="show_count" type="radio" label="MOD_USERTOOLS_GROUPS_FIELD_SHOW_COUNT_LABEL" layout="joomla.form.field.radio.switcher" default="1" filter="integer" showon="mode:members">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>

        <field name="show_empty" type="radio" label="MOD_USERTOOLS_GROUPS_FIELD_SHOW_EMPTY_LABEL" description="MOD_USERTOOLS_GROUPS_FIELD_SHOW_EMPTY_DESC" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
      </fieldset>
      <fieldset name="advanced">
        <field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
        <field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier" />
        <field name="cache" type="list" label="COM_MODULES_FIELD_CACHING_LABEL" default="1" filter="integer" validate="options">
          <option value="1">JGLOBAL_USE_GLOBAL</option>
          <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
        </field>
        <field name="cache_time" type="number" label="COM_MODULES_FIELD_CACHE_TIME_LABEL" default="900" filter="integer" />
        <field name="cachemode" type="hidden" default="static">
          <option value="static"></option>
        </field>
      </fieldset>
    </fields>
  </config>
</extension>
