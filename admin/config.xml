<?xml version="1.0" encoding="utf-8"?>
<config>
  <help key="" url="https://github.com/Danieldiazi/joomla-user-tools#readme" />
  <inlinehelp button="show" />
  <fieldset name="safety" label="COM_USERTOOLS_CONFIG_SAFETY" description="COM_USERTOOLS_CONFIG_SAFETY_DESC">
    <field name="confirm_threshold" type="number" default="10" min="0" max="100000" filter="integer"
      label="COM_USERTOOLS_CONFIG_CONFIRM_THRESHOLD" description="COM_USERTOOLS_CONFIG_CONFIRM_THRESHOLD_DESC" />
    <field name="creation_mode" type="list" default="email" validate="options"
      label="COM_USERTOOLS_CONFIG_CREATION_MODE" description="COM_USERTOOLS_CONFIG_CREATION_MODE_DESC">
      <option value="email">COM_USERTOOLS_CREATION_MODE_EMAIL</option>
      <option value="password">COM_USERTOOLS_CREATION_MODE_PASSWORD</option>
    </field>
    <field name="report_retention_days" type="number" default="90" min="0" max="36500" filter="integer"
      label="COM_USERTOOLS_CONFIG_RETENTION" description="COM_USERTOOLS_CONFIG_RETENTION_DESC" />
  </fieldset>
  <fieldset name="compare" label="COM_USERTOOLS_CONFIG_COMPARE" description="COM_USERTOOLS_CONFIG_COMPARE_DESC">
    <field name="compare_protect_admins" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
      label="COM_USERTOOLS_EXCLUDE_ADMINS" description="COM_USERTOOLS_EXCLUDE_ADMINS_HELP">
      <option value="0">JNO</option><option value="1">JYES</option>
    </field>
    <field name="compare_excluded_names" type="textarea" rows="4" filter="string"
      label="COM_USERTOOLS_EXCLUDED_NAMES" description="COM_USERTOOLS_EXCLUDED_NAMES_DESC" />
    <field name="compare_excluded_groups" type="usergrouplist" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array"
      label="COM_USERTOOLS_EXCLUDED_GROUPS" description="COM_USERTOOLS_EXCLUDED_GROUPS_DESC" />
  </fieldset>
  <fieldset name="inactive" label="COM_USERTOOLS_CONFIG_INACTIVE" description="COM_USERTOOLS_CONFIG_INACTIVE_DESC">
    <field name="inactive_days" type="number" default="365" min="1" max="36500" filter="integer"
      label="COM_USERTOOLS_DAYS_LABEL" description="COM_USERTOOLS_DAYS_HELP" />
    <field name="inactive_include_never" type="radio" layout="joomla.form.field.radio.switcher" default="0" filter="integer"
      label="COM_USERTOOLS_INCLUDE_NEVER" description="COM_USERTOOLS_INCLUDE_NEVER_HELP">
      <option value="0">JNO</option><option value="1">JYES</option>
    </field>
    <field name="inactive_protect_admins" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
      label="COM_USERTOOLS_EXCLUDE_ADMINS" description="COM_USERTOOLS_EXCLUDE_ADMINS_HELP">
      <option value="0">JNO</option><option value="1">JYES</option>
    </field>
    <field name="inactive_excluded_names" type="textarea" rows="4" filter="string"
      label="COM_USERTOOLS_EXCLUDED_NAMES" description="COM_USERTOOLS_EXCLUDED_NAMES_DESC" />
    <field name="inactive_excluded_groups" type="usergrouplist" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array"
      label="COM_USERTOOLS_EXCLUDED_GROUPS" description="COM_USERTOOLS_EXCLUDED_GROUPS_DESC" />
  </fieldset>
  <fieldset name="delete" label="COM_USERTOOLS_CONFIG_DELETE" description="COM_USERTOOLS_CONFIG_DELETE_DESC">
    <field name="delete_days" type="number" default="730" min="1" max="36500" filter="integer"
      label="COM_USERTOOLS_DAYS_LABEL" description="COM_USERTOOLS_DELETE_DAYS_HELP" />
    <field name="delete_include_never" type="radio" layout="joomla.form.field.radio.switcher" default="0" filter="integer"
      label="COM_USERTOOLS_INCLUDE_NEVER" description="COM_USERTOOLS_INCLUDE_NEVER_HELP">
      <option value="0">JNO</option><option value="1">JYES</option>
    </field>
    <field name="delete_status" type="list" default="blocked" validate="options"
      label="COM_USERTOOLS_DELETE_STATUS" description="COM_USERTOOLS_DELETE_STATUS_HELP">
      <option value="blocked">COM_USERTOOLS_DELETE_STATUS_BLOCKED</option>
      <option value="all">COM_USERTOOLS_DELETE_STATUS_ALL</option>
      <option value="active">COM_USERTOOLS_DELETE_STATUS_ACTIVE</option>
    </field>
    <field name="delete_protect_admins" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
      label="COM_USERTOOLS_EXCLUDE_ADMINS" description="COM_USERTOOLS_EXCLUDE_ADMINS_HELP">
      <option value="0">JNO</option><option value="1">JYES</option>
    </field>
    <field name="delete_excluded_names" type="textarea" rows="4" filter="string"
      label="COM_USERTOOLS_EXCLUDED_NAMES" description="COM_USERTOOLS_EXCLUDED_NAMES_DESC" />
    <field name="delete_excluded_groups" type="usergrouplist" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array"
      label="COM_USERTOOLS_EXCLUDED_GROUPS" description="COM_USERTOOLS_EXCLUDED_GROUPS_DESC" />
  </fieldset>
  <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
    <field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_usertools" section="component" />
  </fieldset>
</config>
