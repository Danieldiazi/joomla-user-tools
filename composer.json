{
    "name": "danieldiazi/joomla-user-tools",
    "description": "User Tools for Joomla 6: list comparison, inactivity review and scheduled blocking.",
    "type": "joomla-package",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Danieldiazi\\Component\\Usertools\\Administrator\\": "admin/src/",
            "Danieldiazi\\Plugin\\Task\\Usertools\\": "plugins/task/usertools/src/",
            "Danieldiazi\\Module\\Usertools\\Administrator\\": "modules/mod_usertools/src/",
            "Danieldiazi\\Tests\\": "tests/Unit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
