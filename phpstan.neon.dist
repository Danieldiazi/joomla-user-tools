parameters:
  level: 6
  phpVersion: 80300
  paths:
    - admin/src
    - plugins/task/usertools/src
    - plugins/system/usertools/src
    - modules/mod_usertools/src
    - modules/mod_usertools_groups/src
    - package/script.php
    - scripts/build.php
    - scripts/changelog.php
    - scripts/ReleaseChangelog.php
  bootstrapFiles:
    - tests/phpstan-bootstrap.php
  treatPhpDocTypesAsCertain: false
